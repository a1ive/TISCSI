    IDS_ERR_CONFIG_TARGET_NAME "iSCSI 目標名稱無效: {0}"
    IDS_ERR_CONFIG_SPTI_MIXED "目標 {0}: spti 不能與磁碟或另一個 spti 合併使用。"
    IDS_ERR_CONFIG_NOT_IN_TARGET "{0} 必須位於 [target <名稱>] 區段中。"
    IDS_ERR_CONFIG_NOT_IN_SERVER "{0} 必須位於 [server] 區段中。"
    IDS_ERR_CONFIG_INVALID_LINE "既不是設定也不是區段: {0}"
