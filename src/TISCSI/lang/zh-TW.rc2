// Chinese (Traditional, Taiwan). Missing entries fall back to en-US.

#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

IDR_MAINMENU MENU
BEGIN
    POPUP "檔案(&F)"
    BEGIN
        MENUITEM "開啟設定(&O)...", IDM_FILE_OPEN_CONFIG
        MENUITEM "設定另存新檔(&S)...", IDM_FILE_SAVE_CONFIG
        MENUITEM SEPARATOR
        MENUITEM "結束(&X)", IDM_FILE_EXIT
    END
    POPUP "檢視(&V)"
    BEGIN
        POPUP "語言(&L)"
        BEGIN
            MENUITEM "自動(&A)", IDM_LANG_AUTO
            MENUITEM SEPARATOR
        END
    END
    POPUP "說明(&H)"
    BEGIN
        MENUITEM "關於 TISCSI(&A)...", IDM_HELP_ABOUT
    END
END

// Chinese templates follow the Japanese layout and use Microsoft JhengHei
// (installed with Vista and later; PMingLiU is optional on Windows 10 and
// later) with the Big5 charset, which makes XP fall back to PMingLiU.

IDD_MAIN DIALOGEX 0, 0, 390, 120
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "TISCSI"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    LTEXT           "IP 位址(&I):", IDC_STATIC, 7, 9, 60, 9
    COMBOBOX        IDC_ADDRESS, 68, 7, 132, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "TCP 連接埠(&P):", IDC_STATIC, 205, 9, 50, 9
    EDITTEXT        IDC_PORT, 256, 7, 31, 13, ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON      "啟動(&S)", IDC_START, 293, 6, 90, 15
    LTEXT           "目標(&T):", IDC_STATIC, 7, 30, 60, 9
    CONTROL         "", IDC_TARGETS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 40, 280, 74
    PUSHBUTTON      "新增目標(&A)...", IDC_ADD_TARGET, 293, 40, 90, 15
    PUSHBUTTON      "移除目標(&R)", IDC_REMOVE_TARGET, 293, 58, 90, 15
END

IDD_ADD_TARGET DIALOGEX 0, 0, 360, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新增 iSCSI 目標"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    LTEXT           "目標名稱(&N):", IDC_STATIC, 7, 9, 66, 9
    EDITTEXT        IDC_TARGET_NAME, 75, 7, 170, 13, ES_AUTOHSCROLL
    LTEXT           "磁碟(&D):", IDC_STATIC, 7, 27, 66, 9
    CONTROL         "", IDC_DISKS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 75, 26, 170, 102
    PUSHBUTTON      "建立虛擬磁碟(&V)...", IDC_CREATE_VHD, 251, 26, 102, 14
    PUSHBUTTON      "建立 RAM 磁碟(&R)...", IDC_CREATE_RAMDISK, 251, 43, 102, 14
    PUSHBUTTON      "新增映像(&I)...", IDC_ADD_IMAGE, 251, 60, 102, 14
    PUSHBUTTON      "新增實體磁碟(&P)...", IDC_ADD_PHYSICAL, 251, 77, 102, 14
    PUSHBUTTON      "新增磁碟區(&O)...", IDC_ADD_VOLUME, 251, 94, 102, 14
    PUSHBUTTON      "移除(&M)", IDC_REMOVE_DISK, 251, 111, 102, 14
    PUSHBUTTON      "存取控制(&A)...", IDC_ACCESS, 75, 133, 80, 14
    LTEXT           "", IDC_ACCESS_SUMMARY, 160, 136, 193, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    DEFPUSHBUTTON   "確定", IDOK, 246, 151, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 303, 151, 50, 14
END

IDD_TARGET_ACCESS DIALOGEX 0, 0, 300, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "存取控制"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    LTEXT           "允許的啟動器(&A): 每行一個 iSCSI 名稱。保留空白則允許任何啟動器。", IDC_STATIC, 7, 7, 286, 18
    EDITTEXT        IDC_ALLOWED_INITIATORS, 7, 27, 286, 44, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    GROUPBOX        "CHAP 驗證", IDC_STATIC, 7, 77, 286, 49
    LTEXT           "名稱(&N):", IDC_STATIC, 15, 91, 66, 9
    EDITTEXT        IDC_CHAP_USER, 83, 89, 202, 13, ES_AUTOHSCROLL
    LTEXT           "密碼(&S):", IDC_STATIC, 15, 108, 66, 9
    EDITTEXT        IDC_CHAP_SECRET, 83, 106, 202, 13, ES_PASSWORD | ES_AUTOHSCROLL
    GROUPBOX        "相互 CHAP (目標的名稱與密碼)", IDC_STATIC, 7, 132, 286, 49
    LTEXT           "名稱(&M):", IDC_STATIC, 15, 146, 66, 9
    EDITTEXT        IDC_MUTUAL_USER, 83, 144, 202, 13, ES_AUTOHSCROLL
    LTEXT           "密碼(&E):", IDC_STATIC, 15, 163, 66, 9
    EDITTEXT        IDC_MUTUAL_SECRET, 83, 161, 202, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "密碼的長度為 12 到 255 個字元。CHAP 名稱保留空白則接受任何名稱；相互 CHAP 名稱保留空白則傳送目標名稱。", IDC_STATIC, 7, 187, 286, 27
    DEFPUSHBUTTON   "確定", IDOK, 186, 218, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 243, 218, 50, 14
END

IDD_SELECT_IMAGE DIALOGEX 0, 0, 260, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新增磁碟映像"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    LTEXT           "檔案(&F):", IDC_STATIC, 7, 9, 50, 9
    EDITTEXT        IDC_PATH, 58, 7, 140, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "瀏覽(&B)...", IDC_BROWSE, 203, 6, 50, 15
    AUTOCHECKBOX    "唯讀(&R)", IDC_READ_ONLY, 58, 27, 180, 10
    AUTOCHECKBOX    "以 CD/DVD-ROM 光碟機提供(&C)", IDC_OPTICAL, 58, 41, 180, 10
    DEFPUSHBUTTON   "確定", IDOK, 146, 58, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 203, 58, 50, 14
END

IDD_CREATE_VHD DIALOGEX 0, 0, 260, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "建立虛擬磁碟"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    LTEXT           "檔案(&F):", IDC_STATIC, 7, 9, 50, 9
    EDITTEXT        IDC_PATH, 58, 7, 140, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "瀏覽(&B)...", IDC_BROWSE, 203, 6, 50, 15
    LTEXT           "大小(&S):", IDC_STATIC, 7, 28, 50, 9
    EDITTEXT        IDC_SIZE_MB, 58, 26, 60, 13, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_SIZE_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 118, 26, 10, 13
    LTEXT           "MB", IDC_STATIC, 123, 28, 20, 9
    AUTOCHECKBOX    "動態擴充(&D)", IDC_DYNAMIC, 58, 45, 160, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 7, 61, 246, 9
    DEFPUSHBUTTON   "確定", IDOK, 146, 76, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 203, 76, 50, 14
END

IDD_CREATE_RAMDISK DIALOGEX 0, 0, 190, 50
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "建立 RAM 磁碟"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    LTEXT           "大小(&S):", IDC_STATIC, 7, 9, 50, 9
    EDITTEXT        IDC_SIZE_MB, 58, 7, 60, 13, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_SIZE_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 118, 7, 10, 13
    LTEXT           "MB", IDC_STATIC, 123, 9, 20, 9
    DEFPUSHBUTTON   "確定", IDOK, 76, 30, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 133, 30, 50, 14
END

IDD_SELECT_PHYSICAL DIALOGEX 0, 0, 340, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新增實體磁碟"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    CONTROL         "", IDC_DEVICE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 7, 326, 116
    AUTOCHECKBOX    "唯讀(&R)", IDC_READ_ONLY, 7, 132, 140, 10
    DEFPUSHBUTTON   "確定", IDOK, 226, 130, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 283, 130, 50, 14
END

IDD_SELECT_VOLUME DIALOGEX 0, 0, 410, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新增磁碟區"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    CONTROL         "", IDC_DEVICE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 7, 396, 116
    AUTOCHECKBOX    "唯讀(&R)", IDC_READ_ONLY, 7, 132, 140, 10
    DEFPUSHBUTTON   "確定", IDOK, 296, 130, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 353, 130, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 270, 124
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "關於 TISCSI"
FONT 9, "Microsoft JhengHei", 0, 0, 0x88
BEGIN
    ICON            IDI_APP, IDC_STATIC, 10, 10, 20, 20
    LTEXT           "TISCSI", IDC_STATIC, 42, 10, 218, 9
    LTEXT           "", IDC_ABOUT_VERSION, 42, 22, 218, 9
    LTEXT           "Copyright (C) 2026 A1ive", IDC_STATIC, 42, 34, 218, 9
    LTEXT           "以 Tal Aloni 的 iSCSI Console 為基礎。", IDC_STATIC, 42, 46, 218, 9
    LTEXT           "本程式為自由軟體，依 GNU 通用公眾授權條款 (GPL) 第 3 版或 (依您的選擇) 任何更新版本的條款散布。", IDC_STATIC, 42, 62, 218, 30
    DEFPUSHBUTTON   "確定", IDOK, 210, 102, 50, 14
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE           "TISCSI"
    IDS_ABOUT_VERSION       "版本 {0}"
    IDS_USAGE               "命令列選項:\n\n/log\t在程式所在資料夾寫入記錄檔\n--log=<檔案>\t將記錄寫入指定的檔案\n--lang=<標記>\t介面語言 (en-US、ja-JP、zh-CN、zh-TW、ko-KR)\n--config=<檔案>\t開啟設定檔並啟動伺服器"
    IDS_ERR_LOG_FILE        "無法開啟記錄檔 {0}:\n{1}"

