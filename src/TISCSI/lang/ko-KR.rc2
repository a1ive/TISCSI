// Korean (Korea). Missing entries fall back to en-US.

#pragma code_page(65001)

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

IDR_MAINMENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "구성 열기(&O)...", IDM_FILE_OPEN_CONFIG
        MENUITEM "다른 이름으로 구성 저장(&S)...", IDM_FILE_SAVE_CONFIG
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)", IDM_FILE_EXIT
    END
    POPUP "보기(&V)"
    BEGIN
        POPUP "언어(&L)"
        BEGIN
            MENUITEM "자동(&A)", IDM_LANG_AUTO
            MENUITEM SEPARATOR
        END
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "TISCSI 정보(&A)...", IDM_HELP_ABOUT
    END
END

// Korean templates follow the Japanese layout and use Malgun Gothic
// (installed with Vista and later; Gulim is optional on Windows 10 and later)
// with the Hangul charset, which makes XP fall back to Gulim.

IDD_MAIN DIALOGEX 0, 0, 390, 120
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "TISCSI"
FONT 9, "Malgun Gothic", 0, 0, 0x81
BEGIN
    LTEXT           "IP 주소(&I):", IDC_STATIC, 7, 9, 60, 9
    COMBOBOX        IDC_ADDRESS, 68, 7, 132, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "TCP 포트(&P):", IDC_STATIC, 205, 9, 50, 9
    EDITTEXT        IDC_PORT, 256, 7, 31, 13, ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON      "시작(&S)", IDC_START, 293, 6, 90, 15
    LTEXT           "대상(&T):", IDC_STATIC, 7, 30, 60, 9
    CONTROL         "", IDC_TARGETS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 40, 280, 74
    PUSHBUTTON      "대상 추가(&A)...", IDC_ADD_TARGET, 293, 40, 90, 15
    PUSHBUTTON      "대상 제거(&R)", IDC_REMOVE_TARGET, 293, 58, 90, 15
END

IDD_ADD_TARGET DIALOGEX 0, 0, 360, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iSCSI 대상 추가"
FONT 9, "Malgun Gothic", 0, 0, 0x81
BEGIN
    LTEXT           "대상 이름(&N):", IDC_STATIC, 7, 9, 66, 9
    EDITTEXT        IDC_TARGET_NAME, 75, 7, 170, 13, ES_AUTOHSCROLL
    LTEXT           "디스크(&D):", IDC_STATIC, 7, 27, 66, 9
    CONTROL         "", IDC_DISKS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 75, 26, 170, 102
    PUSHBUTTON      "가상 디스크 만들기(&V)...", IDC_CREATE_VHD, 251, 26, 102, 14
    PUSHBUTTON      "RAM 디스크 만들기(&R)...", IDC_CREATE_RAMDISK, 251, 43, 102, 14
    PUSHBUTTON      "이미지 추가(&I)...", IDC_ADD_IMAGE, 251, 60, 102, 14
    PUSHBUTTON      "물리적 디스크 추가(&P)...", IDC_ADD_PHYSICAL, 251, 77, 102, 14
    PUSHBUTTON      "볼륨 추가(&O)...", IDC_ADD_VOLUME, 251, 94, 102, 14
    PUSHBUTTON      "제거(&M)", IDC_REMOVE_DISK, 251, 111, 102, 14
    PUSHBUTTON      "액세스 제어(&A)...", IDC_ACCESS, 75, 133, 80, 14
    LTEXT           "", IDC_ACCESS_SUMMARY, 160, 136, 193, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    DEFPUSHBUTTON   "확인", IDOK, 246, 151, 50, 14
    PUSHBUTTON      "취소", IDCANCEL, 303, 151, 50, 14
END

IDD_TARGET_ACCESS DIALOGEX 0, 0, 300, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "액세스 제어"
FONT 9, "Malgun Gothic", 0, 0, 0x81
BEGIN
    LTEXT           "허용할 이니시에이터(&A): 한 줄에 iSCSI 이름을 하나씩 입력합니다. 비워 두면 모든 이니시에이터를 허용합니다.", IDC_STATIC, 7, 7, 286, 18
    EDITTEXT        IDC_ALLOWED_INITIATORS, 7, 27, 286, 44, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    GROUPBOX        "CHAP 인증", IDC_STATIC, 7, 77, 286, 49
    LTEXT           "이름(&N):", IDC_STATIC, 15, 91, 66, 9
    EDITTEXT        IDC_CHAP_USER, 83, 89, 202, 13, ES_AUTOHSCROLL
    LTEXT           "암호(&S):", IDC_STATIC, 15, 108, 66, 9
    EDITTEXT        IDC_CHAP_SECRET, 83, 106, 202, 13, ES_PASSWORD | ES_AUTOHSCROLL
    GROUPBOX        "상호 CHAP (대상의 이름과 암호)", IDC_STATIC, 7, 132, 286, 49
    LTEXT           "이름(&M):", IDC_STATIC, 15, 146, 66, 9
    EDITTEXT        IDC_MUTUAL_USER, 83, 144, 202, 13, ES_AUTOHSCROLL
    LTEXT           "암호(&E):", IDC_STATIC, 15, 163, 66, 9
    EDITTEXT        IDC_MUTUAL_SECRET, 83, 161, 202, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "암호는 12~255자입니다. CHAP 이름을 비워 두면 모든 이름을 허용하고, 상호 CHAP 이름을 비워 두면 대상 이름을 보냅니다.", IDC_STATIC, 7, 187, 286, 27
    DEFPUSHBUTTON   "확인", IDOK, 186, 218, 50, 14
    PUSHBUTTON      "취소", IDCANCEL, 243, 218, 50, 14
END

IDD_SELECT_IMAGE DIALOGEX 0, 0, 260, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "디스크 이미지 추가"
FONT 9, "Malgun Gothic", 0, 0, 0x81
BEGIN
