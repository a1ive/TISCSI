#pragma code_page(65001)

LANGUAGE LANG_TURKISH, SUBLANG_TURKISH_TURKEY

IDR_MAINMENU MENU
BEGIN
    POPUP "&Dosya"
    BEGIN
        MENUITEM "Yapılandırma &Aç...", IDM_FILE_OPEN_CONFIG
        MENUITEM "Yapılandırmayı &Farklı Kaydet...", IDM_FILE_SAVE_CONFIG
        MENUITEM SEPARATOR
        MENUITEM "Çı&kış", IDM_FILE_EXIT
    END
    POPUP "&Görünüm"
    BEGIN
        POPUP "&Dil"
        BEGIN
            MENUITEM "&Otomatik", IDM_LANG_AUTO
            MENUITEM SEPARATOR
        END
    END
    POPUP "&Yardım"
    BEGIN
        MENUITEM "TISCSI &Hakkında...", IDM_HELP_ABOUT
    END
END

IDD_MAIN DIALOGEX 0, 0, 350, 120
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "TISCSI"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "&IP adresi:", IDC_STATIC, 7, 9, 45, 8
    COMBOBOX        IDC_ADDRESS, 54, 7, 142, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "TCP &portu:", IDC_STATIC, 203, 9, 37, 8
    EDITTEXT        IDC_PORT, 241, 7, 35, 13, ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON      "&Başlat", IDC_START, 283, 6, 60, 15
    LTEXT           "&Hedefler:", IDC_STATIC, 7, 30, 45, 8
    CONTROL         "", IDC_TARGETS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 40, 269, 74
    PUSHBUTTON      "Hedef &Ekle...", IDC_ADD_TARGET, 283, 40, 60, 15
    PUSHBUTTON      "Hedefi &Kaldır", IDC_REMOVE_TARGET, 283, 58, 60, 15
END

IDD_ADD_TARGET DIALOGEX 0, 0, 316, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iSCSI Hedefi Ekle"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Hedef &adı:", IDC_STATIC, 7, 9, 50, 8
    EDITTEXT        IDC_TARGET_NAME, 58, 7, 172, 13, ES_AUTOHSCROLL
    LTEXT           "&Diskler:", IDC_STATIC, 7, 27, 50, 8
    CONTROL         "", IDC_DISKS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 58, 26, 172, 102
    PUSHBUTTON      "&Sanal Disk Oluştur...", IDC_CREATE_VHD, 236, 26, 73, 14
    PUSHBUTTON      "&RAM Diski Oluştur...", IDC_CREATE_RAMDISK, 236, 43, 73, 14
    PUSHBUTTON      "Disk &Görüntüsü Ekle...", IDC_ADD_IMAGE, 236, 60, 73, 14
    PUSHBUTTON      "&Fiziksel Disk Ekle...", IDC_ADD_PHYSICAL, 236, 77, 73, 14
    PUSHBUTTON      "&Birim Ekle...", IDC_ADD_VOLUME, 236, 94, 73, 14
    PUSHBUTTON      "Ka&ldır", IDC_REMOVE_DISK, 236, 111, 73, 14
    PUSHBUTTON      "Erişi&m...", IDC_ACCESS, 58, 133, 60, 14
    LTEXT           "", IDC_ACCESS_SUMMARY, 123, 136, 186, 8, SS_NOPREFIX | SS_ENDELLIPSIS
    DEFPUSHBUTTON   "Tamam", IDOK, 202, 151, 50, 14
    PUSHBUTTON      "İptal", IDCANCEL, 259, 151, 50, 14
END

IDD_TARGET_ACCESS DIALOGEX 0, 0, 260, 233
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Erişim Denetimi"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "İzin verilen &başlatıcılar: her satıra bir iSCSI adı girin. Tümüne izin vermek için boş bırakın.", IDC_STATIC, 7, 7, 246, 16
    EDITTEXT        IDC_ALLOWED_INITIATORS, 7, 25, 246, 44, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    GROUPBOX        "CHAP kimlik doğrulaması", IDC_STATIC, 7, 75, 246, 49
    LTEXT           "&Ad:", IDC_STATIC, 15, 89, 58, 8
    EDITTEXT        IDC_CHAP_USER, 75, 87, 170, 13, ES_AUTOHSCROLL
    LTEXT           "&Parola:", IDC_STATIC, 15, 106, 58, 8
    EDITTEXT        IDC_CHAP_SECRET, 75, 104, 170, 13, ES_PASSWORD | ES_AUTOHSCROLL
    GROUPBOX        "Karşılıklı CHAP (hedefin adı ve parolası)", IDC_STATIC, 7, 130, 246, 49
    LTEXT           "A&d:", IDC_STATIC, 15, 144, 58, 8
    EDITTEXT        IDC_MUTUAL_USER, 75, 142, 170, 13, ES_AUTOHSCROLL
    LTEXT           "Pa&rola:", IDC_STATIC, 15, 161, 58, 8
    EDITTEXT        IDC_MUTUAL_SECRET, 75, 159, 170, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Parolalar 12 ile 255 karakter uzunluğundadır. CHAP adı boşsa tüm adlar kabul edilir. Karşılıklı CHAP adı boşsa hedef adı gönderilir.", IDC_STATIC, 7, 185, 246, 24
    DEFPUSHBUTTON   "Tamam", IDOK, 146, 213, 50, 14
    PUSHBUTTON      "İptal", IDCANCEL, 203, 213, 50, 14
END

IDD_SELECT_IMAGE DIALOGEX 0, 0, 244, 78
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Disk Görüntüsü Ekle"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "&Dosya:", IDC_STATIC, 7, 9, 26, 8
    EDITTEXT        IDC_PATH, 35, 7, 146, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "&Gözat...", IDC_BROWSE, 187, 6, 50, 15
    AUTOCHECKBOX    "&Salt okunur", IDC_READ_ONLY, 35, 27, 180, 10
    AUTOCHECKBOX    "&CD/DVD-ROM sürücüsü olarak sun", IDC_OPTICAL, 35, 41, 180, 10
    DEFPUSHBUTTON   "Tamam", IDOK, 130, 58, 50, 14
    PUSHBUTTON      "İptal", IDCANCEL, 187, 58, 50, 14
END

IDD_CREATE_VHD DIALOGEX 0, 0, 244, 96
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sanal Disk Oluştur"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "&Dosya:", IDC_STATIC, 7, 9, 26, 8
    EDITTEXT        IDC_PATH, 35, 7, 146, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "&Gözat...", IDC_BROWSE, 187, 6, 50, 15
    LTEXT           "&Boyut:", IDC_STATIC, 7, 28, 26, 8
    EDITTEXT        IDC_SIZE_MB, 35, 26, 60, 13, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_SIZE_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 95, 26, 10, 13
    LTEXT           "MB", IDC_STATIC, 100, 28, 20, 8
    AUTOCHECKBOX    "&Dinamik olarak genişleyen", IDC_DYNAMIC, 35, 45, 160, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 7, 61, 230, 9
    DEFPUSHBUTTON   "Tamam", IDOK, 130, 76, 50, 14
    PUSHBUTTON      "İptal", IDCANCEL, 187, 76, 50, 14
END

