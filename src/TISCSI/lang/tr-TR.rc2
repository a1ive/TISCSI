IDD_ABOUT DIALOGEX 0, 0, 260, 118
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TISCSI Hakkında"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_APP, IDC_STATIC, 10, 10, 20, 20
    LTEXT           "TISCSI", IDC_STATIC, 42, 10, 208, 8
    LTEXT           "", IDC_ABOUT_VERSION, 42, 22, 208, 8
    LTEXT           "Copyright (C) 2026 A1ive", IDC_STATIC, 42, 34, 208, 8
    LTEXT           "Tal Aloni'nin iSCSI Console yazılımını temel alır.", IDC_STATIC, 42, 46, 208, 8
    LTEXT           "Bu program özgür yazılımdır; GNU Genel Kamu Lisansı'nın 3. sürümü veya (tercihinize bağlı olarak) sonraki bir sürümü kapsamında dağıtılır.", IDC_STATIC, 42, 62, 208, 26
    DEFPUSHBUTTON   "Tamam", IDOK, 200, 96, 50, 14
END

