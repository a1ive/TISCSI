// Language-neutral resources. Localized strings live in lang\*.rc2.

#include <windows.h>
#include "resource.h"
#include "TISCSI/version.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "TISCSICli.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TISCSI_VERSION_MAJOR, TISCSI_VERSION_MINOR, TISCSI_VERSION_PATCH, 0
 PRODUCTVERSION TISCSI_VERSION_MAJOR, TISCSI_VERSION_MINOR, TISCSI_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "A1ive"
            VALUE "FileDescription", "TISCSI iSCSI Target Server (command line)"
            VALUE "FileVersion", TISCSI_VERSION_STRING
            VALUE "InternalName", "TISCSICli"
            VALUE "LegalCopyright", "Copyright (C) 2026 A1ive. Licensed under GPL-3.0-or-later."
            VALUE "OriginalFilename", "TISCSICli.exe"
            VALUE "ProductName", "TISCSI"
            VALUE "ProductVersion", TISCSI_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

#include "lang/en-US.rc2"
#include "lang/ja-JP.rc2"
#include "lang/zh-CN.rc2"
#include "lang/zh-TW.rc2"
#include "lang/ko-KR.rc2"
#include "lang/tr-TR.rc2"
