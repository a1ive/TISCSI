// Korean (Korea). Missing entries fall back to en-US.

#pragma code_page(65001)

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

STRINGTABLE
BEGIN
    IDS_CLI_USAGE "사용법: TISCSICli [옵션] [--target <이름>] <디스크>... [--target <이름> <디스크>...]...\n\n\
디스크 이미지와 RAM 디스크를 iSCSI 이니시에이터에 제공합니다.\n\n\
디스크 (지정한 순서대로 현재 대상의 다음 LUN이 됩니다):\n\
  --image <경로>       디스크 이미지, 읽기/쓰기 (.vhd, .vmdk, 그 밖의 확장명은 원시 이미지)\n\
                       .iso 이미지는 읽기 전용 CD/DVD-ROM 드라이브가 됩니다\n\
  --image-ro <경로>    디스크 이미지, 읽기 전용\n\
  --cdrom <경로>       임의의 파일을 읽기 전용 CD/DVD-ROM 드라이브의 디스크로 제공\n\
  --ram <크기>         새 RAM 디스크 (예: 512M, 2G)\n\
  --disk <번호>        물리적 디스크, 읽기/쓰기 (디스크의 볼륨을 잠급니다)\n\
  --disk-ro <번호>     물리적 디스크, 읽기 전용\n\
  --volume <볼륨>      볼륨 (E:, 탑재 지점 또는 \\\\?\\Volume{...}\\), 읽기/쓰기\n\
  --volume-ro <볼륨>   볼륨, 읽기 전용\n\
  --dynamic-volume <ID>\n\
                       동적 볼륨 (GUID, Volume1 같은 이름 또는 E:), 읽기/쓰기.\n\
                       Windows가 탑재하지 않은 볼륨도 사용할 수 있습니다\n\
  --dynamic-volume-ro <ID>\n\
                       동적 볼륨, 읽기 전용\n\
  --ldm-disk <이미지>  물리적 디스크 대신 구성원 디스크의 이 이미지에서\n\
                       동적 볼륨을 찾습니다 (구성원마다 지정)\n\n\
대상:\n\
  --target <이름>      새 대상을 시작합니다. 이후의 디스크는 이 대상에 속합니다.\n\
                       --target 앞에 지정한 디스크는\n\
                       iqn.1991-05.com.microsoft:target1에 속합니다\n\
  --spti <장치>        대상의 SCSI 명령을 로컬 장치로 패스스루합니다\n\
                       (\\\\.\\CdRom0, \\\\.\\Tape0, \\\\.\\Scsi2: 등)\n\
  --list               물리적 디스크, 볼륨, 동적 볼륨, SCSI 장치를 나열합니다\n\
                       (디스크, 볼륨, --spti에는 관리자 권한이 필요합니다.\n\
                       --ldm-disk의 동적 볼륨은 제외)\n\n\
VHD 만들기 (디스크도 지정한 경우에만 이어서 서버를 시작합니다):\n\
  --create-vhd <경로>  새 VHD 파일을 만듭니다\n\
  --size <크기>        새 VHD의 크기 (예: 20G, 최대 2040G)\n\
  --dynamic            동적 확장 VHD를 만듭니다 (기본값: 고정 크기)\n\n\
서버:\n\
  --listen <주소>      수신 대기할 IPv4 주소 (기본값: 모든 인터페이스)\n\
  --port <포트>        TCP 포트 (기본값: 3260)\n\
  --log <파일>         로그를 파일에도 기록합니다\n\
  --verbosity <수준>   error, warning, info (기본값), verbose 또는 debug\n\
  --lang <태그>        표시 언어: en-US, ja-JP, zh-CN, zh-TW 또는 ko-KR\n\
                       (기본값: Windows 표시 언어)\n\
  --help               이 도움말을 표시합니다\n\n\
예:\n\
  TISCSICli --target iqn.2026-10.example:disk1 --image D:\\disk.vhd --ram 1G\n\
  TISCSICli --create-vhd D:\\new.vhd --size 20G --dynamic --image D:\\new.vhd\n"
    IDS_CLI_LISTENING "{0}:{1}에서 수신 대기 중"
    IDS_CLI_TARGET "대상: {0}"
    IDS_CLI_LUN "  LUN {0}: {1}, {2}{3}"
    IDS_CLI_READ_ONLY " (읽기 전용)"
    IDS_CLI_RAM_DISK "RAM 디스크"
    IDS_CLI_PRESS_CTRL_C "서버를 중지하려면 Ctrl+C를 누르십시오."
    IDS_CLI_STOPPING "서버를 중지하는 중..."
    IDS_CLI_STOPPED "서버가 중지되었습니다."
    IDS_CLI_CREATING "{0}을(를) 만드는 중 ({1}, {2})..."
    IDS_CLI_CREATED "{0}을(를) 만들었습니다."
    IDS_CLI_VHD_FIXED "고정 크기"
    IDS_CLI_VHD_DYNAMIC "동적 확장"
    IDS_CLI_PHYSICAL_DISK "물리적 디스크 {0}"
    IDS_CLI_VOLUME "볼륨 {0}"
    IDS_CLI_SPTI "  {0}(으)로 SCSI 패스스루 (LUN {1}개)"
    IDS_CLI_HINT_ADMIN "물리적 디스크, 볼륨, SCSI 패스스루를 사용하려면 관리자 권한으로 실행해야 합니다."
    IDS_CLI_LIST_DISKS "물리적 디스크:"
    IDS_CLI_LIST_DISK "  {0}: {1}, {2}{3}"
    IDS_CLI_LIST_DYNAMIC " (동적 디스크)"
    IDS_CLI_LIST_VOLUMES "볼륨:"
    IDS_CLI_LIST_VOLUME "  {0}\n    탑재 지점: {1}, 파일 시스템: {2}, 레이블: {3}, 크기: {4}, 디스크: {5}"
    IDS_CLI_LIST_SCSI "SCSI 장치:"
    IDS_CLI_LIST_DYNAMIC_VOLUMES "동적 볼륨:"
    IDS_CLI_LIST_DYNAMIC_VOLUME "  {0}  {1}\n    디스크 그룹: {2}, 레이아웃: {3}, 상태: {4}, 크기: {5}, 디스크: {6}\n    {7}"
    IDS_CLI_LIST_WINDOWS_VOLUME "Windows 볼륨: {0}"
    IDS_CLI_LIST_NOT_MOUNTED "Windows가 탑재하지 않음, 구성원 디스크에서 직접 제공"
    IDS_CLI_DYNAMIC_VOLUME "동적 볼륨 {0}"
    IDS_CLI_LAYOUT_SIMPLE "단순"
    IDS_CLI_LAYOUT_SPANNED "스팬"
    IDS_CLI_LAYOUT_STRIPED "스트라이프"
    IDS_CLI_LAYOUT_MIRRORED "미러"
    IDS_CLI_LAYOUT_RAID5 "RAID-5"
    IDS_CLI_HEALTH_HEALTHY "정상"
    IDS_CLI_HEALTH_FAILED_REDUNDANCY "중복 실패"
    IDS_CLI_HEALTH_FAILED "실패"

    IDS_CLI_ERR_UNKNOWN_OPTION "알 수 없는 옵션: {0}"
    IDS_CLI_ERR_MISSING_VALUE "{0} 옵션에는 값이 필요합니다."
    IDS_CLI_ERR_INVALID_SIZE "잘못된 크기: {0}"
    IDS_CLI_ERR_INVALID_PORT "잘못된 포트: {0}"
    IDS_CLI_ERR_INVALID_ADDRESS "잘못된 IPv4 주소: {0}"
    IDS_CLI_ERR_INVALID_LEVEL "잘못된 로그 수준: {0}"
    IDS_CLI_ERR_INVALID_TARGET_NAME "잘못된 iSCSI 대상 이름: {0}"
    IDS_CLI_ERR_DUPLICATE_TARGET "대상 이름이 중복되었습니다: {0}"
    IDS_CLI_ERR_NO_DISKS "디스크를 지정하지 않았습니다. --image, --image-ro 또는 --ram을 사용하십시오."
    IDS_CLI_ERR_TARGET_WITHOUT_DISKS "대상 {0}에 디스크가 없습니다."
    IDS_CLI_ERR_OPEN_IMAGE "디스크 이미지 {0}을(를) 열 수 없습니다: {1}"
    IDS_CLI_ERR_RAM_ALLOC "{0} 크기의 RAM 디스크를 할당할 수 없습니다."
    IDS_CLI_ERR_LOG_FILE "로그 파일 {0}을(를) 열 수 없습니다: {1}"
    IDS_CLI_ERR_START "서버를 시작할 수 없습니다: {0}"
    IDS_CLI_ERR_HINT_HELP "사용법은 TISCSICli --help로 확인하십시오."
    IDS_CLI_ERR_VHD_SIZE "잘못된 VHD 크기: {0} (512바이트의 배수, 최대 2040GiB)"
    IDS_CLI_ERR_CREATE_NEEDS_SIZE "--create-vhd에는 --size가 필요합니다."
    IDS_CLI_ERR_SIZE_WITHOUT_CREATE "--size와 --dynamic은 --create-vhd와 함께만 사용할 수 있습니다."
    IDS_CLI_ERR_CREATE "{0}을(를) 만들 수 없습니다: {1}"
    IDS_CLI_ERR_INVALID_DISK "잘못된 디스크 번호: {0} (--list 참조)"
    IDS_CLI_ERR_SPTI_MIXED "대상 {0}: --spti는 디스크나 다른 --spti와 함께 사용할 수 없습니다."
    IDS_CLI_ERR_OPEN_SPTI "SCSI 장치 {0}을(를) 열 수 없습니다: {1}"
    IDS_CLI_ERR_DYNAMIC_DISK "{0}은(는) 동적 디스크입니다. 이니시에이터에서 쓰면 동적 디스크 데이터베이스가 손상될 수 있으므로 읽기 전용(--disk-ro)으로 제공하십시오."
    IDS_CLI_ERR_VOLUME_LOCKED "볼륨 {0}을(를) 단독으로 잠글 수 없습니다 ({1}). 사용 중인 프로그램을 닫거나 읽기 전용으로 제공하십시오."
    IDS_CLI_ERR_ALREADY_SERVED "{0}은(는) 이미 제공 중입니다."
    IDS_CLI_ERR_WRITE_PROTECTED "{0}은(는) 쓰기 금지되어 있습니다. 읽기 전용으로 제공하십시오."
    IDS_CLI_ERR_OPEN_DEVICE "'{0}'을(를) 열 수 없습니다: {1}"
    IDS_CLI_ERR_NO_SUCH_VOLUME "'{0}'과(와) 일치하는 동적 볼륨이 없습니다 (--list 참조)."
    IDS_CLI_ERR_AMBIGUOUS_VOLUME "이름이 '{0}'인 동적 볼륨이 여러 개 있습니다. GUID로 지정하십시오 (--list 참조)."
    IDS_CLI_ERR_VOLUME_FAILED "동적 볼륨 '{0}'을(를) 사용할 수 없습니다: 데이터가 있는 디스크가 없습니다."
    IDS_CLI_ERR_DEGRADED_WRITE "동적 볼륨 '{0}'에 구성원 디스크가 없습니다. 쓰면 구성원 사이의 일관성이 깨지므로 읽기 전용(--dynamic-volume-ro)으로 제공하십시오."
    IDS_CLI_ERR_LDM_UNUSED "--ldm-disk는 --dynamic-volume, --dynamic-volume-ro 또는 --list와 함께 사용해야 합니다."
END
