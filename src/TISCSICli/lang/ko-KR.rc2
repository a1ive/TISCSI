// Korean (Korea). Missing entries fall back to en-US.

#pragma code_page(65001)

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

STRINGTABLE
BEGIN
    IDS_CLI_USAGE "사용법: TISCSICli [옵션] [--target <이름>] <디스크>... [--target <이름> <디스크>...]...\n\n\
디스크 이미지와 RAM 디스크를 iSCSI 이니시에이터에 제공합니다.\n\n\
디스크 (지정한 순서대로 현재 대상의 다음 LUN이 됩니다):\n\
  --image <경로>       디스크 이미지, 읽기/쓰기 (.vhd, .vhdx, .avhdx, .vmdk, 그 밖의 확장명은 원시 이미지)\n\
                       .iso 이미지는 읽기 전용 CD/DVD-ROM 드라이브가 됩니다\n\
  --image-ro <경로>    디스크 이미지, 읽기 전용\n\
  --cdrom <경로>       임의의 파일을 읽기 전용 CD/DVD-ROM 드라이브의 디스크로 제공\n\
  --ram <크기>         새 RAM 디스크 (예: 512M, 2G)\n\
  --disk <디스크>      물리적 디스크, 읽기/쓰기 (디스크의 볼륨을 잠급니다).\n\
                       디스크 번호 또는 --list에 표시되는 고정 이름으로\n\
                       지정합니다. 고정 이름은 디스크 번호가 바뀌어도 그대로입니다\n\
                       (serial:<일련 번호>, gpt:{<디스크 GUID>}, mbr:<디스크 서명>)\n\
  --disk-ro <디스크>   물리적 디스크, 읽기 전용\n\
  --volume <볼륨>      볼륨, 읽기/쓰기: E:, 탑재 지점, \\\\?\\Volume{...}\\ 또는\n\
                       --list에 표시되는 고정 이름\n\
                       (gpt:{<파티션 GUID>}, mbr:<디스크 서명>:<오프셋>)\n\
  --volume-ro <볼륨>   볼륨, 읽기 전용\n\
  --dynamic-volume <ID>\n\
                       동적 볼륨 (GUID, Volume1 같은 이름 또는 E:), 읽기/쓰기.\n\
                       Windows가 탑재하지 않은 볼륨도 사용할 수 있습니다\n\
  --dynamic-volume-ro <ID>\n\
                       동적 볼륨, 읽기 전용\n\
  --ldm-disk <이미지>  물리적 디스크 대신 구성원 디스크의 이 이미지에서\n\
                       동적 볼륨을 찾습니다 (구성원마다 지정)\n\n\
대상:\n\
  --target <이름>      새 대상을 시작합니다. 이후의 디스크는 이 대상에 속합니다.\n\
                       --target 앞에 지정한 디스크는\n\
                       iqn.1991-05.com.microsoft:target1에 속합니다\n\
  --spti <장치>        대상의 SCSI 명령을 로컬 장치로 패스스루합니다\n\
                       (\\\\.\\CdRom0, \\\\.\\Tape0, \\\\.\\Scsi2: 등\n\
                       또는 serial:<일련 번호>, --list 참조)\n\
  --list               물리적 디스크, 볼륨, 동적 볼륨, SCSI 장치를 나열합니다\n\
                       (디스크, 볼륨, --spti에는 관리자 권한이 필요합니다.\n\
                       --ldm-disk의 동적 볼륨은 제외)\n\n\
VHD 만들기 (디스크도 지정한 경우에만 이어서 서버를 시작합니다):\n\
  --create-vhd <경로>  새 VHD 파일을 만듭니다\n\
  --size <크기>        새 VHD의 크기 (예: 20G, 최대 2040G)\n\
  --dynamic            동적 확장 VHD를 만듭니다 (기본값: 고정 크기)\n\n\
서버:\n\
  --listen <주소>      수신 대기할 IPv4 주소 (기본값: 모든 인터페이스)\n\
  --port <포트>        TCP 포트 (기본값: 3260)\n\
  --log <파일>         로그를 파일에도 기록합니다\n\
  --verbosity <수준>   error, warning, info (기본값), verbose 또는 debug\n\
  --wait <초>          시작할 때 아직 없는 디스크, 볼륨, 이미지와 --listen 주소를\n\
                       이 시간(초)만큼 기다립니다\n\
  --skip-unavailable   열 수 없는 대상이 있어도 다른 대상을 제공합니다\n\
                       (기본값: 아무것도 제공하지 않음)\n\
  --lang <태그>        표시 언어: en-US, ja-JP, zh-CN, zh-TW 또는 ko-KR\n\
                       (기본값: Windows 표시 언어)\n\
  --help               이 도움말을 표시합니다\n\n"
    IDS_CLI_USAGE_MORE "액세스 제어 (현재 대상):\n\
  --allow-initiator <이름>\n\
                       이 이니시에이터만 로그온할 수 있습니다 (여러 번 지정 가능).\n\
                       다른 이니시에이터는 검색에서 대상을 볼 수 없습니다\n\
  --chap-secret <암호>\n\
                       이 암호로 CHAP 인증을 요구합니다 (12~255자)\n\
  --chap-user <이름>   이니시에이터가 사용해야 하는 CHAP 이름 (기본값: 아무 이름)\n\
  --mutual-chap-secret <암호>\n\
                       이니시에이터의 상호 CHAP 챌린지에 응답할 암호\n\
                       (--chap-secret과 달라야 함)\n\
  --mutual-chap-user <이름>\n\
                       대상의 CHAP 이름 (기본값: 대상 이름)\n\
                       명령줄의 암호는 다른 프로그램에서 볼 수 있으므로\n\
                       구성 파일을 사용하는 것이 좋습니다\n\n\
구성 파일:\n\
  --config <파일>      서버 옵션, 대상, 디스크를 파일에서 읽습니다. 함께 지정한\n\
                       서버 옵션이 파일의 설정보다 우선합니다\n\
  --save-config <파일> 제공하지 않고 대상과 옵션을 파일에 씁니다.\n\
                       장치는 고정 이름으로 저장됩니다\n\n\
Windows 서비스 (관리자 권한 필요):\n\
  --install-service    --config 파일을 Windows 시작 시(로그온 전)부터 제공하는\n\
                       서비스를 설치하고 시작합니다. 다시 실행하면 업데이트합니다.\n\
                       로그는 구성 파일의 log 또는 구성 파일 옆의\n\
                       TISCSI-service.log에 기록됩니다\n\
  --uninstall-service  서비스를 중지하고 제거합니다\n\
  --service-name <이름>\n\
                       서비스 이름 (기본값: TISCSI)\n\n\
예:\n\
  TISCSICli --target iqn.2026-10.example:disk1 --image D:\\disk.vhd --ram 1G\n\
  TISCSICli --create-vhd D:\\new.vhd --size 20G --dynamic --image D:\\new.vhd\n\
  TISCSICli --config D:\\tiscsi\\server.conf --wait 60\n\
  TISCSICli --install-service --config D:\\tiscsi\\server.conf\n"
    IDS_CLI_LISTENING "{0}:{1}에서 수신 대기 중"
    IDS_CLI_TARGET "대상: {0}"
    IDS_CLI_LUN "  LUN {0}: {1}, {2}{3}"
    IDS_CLI_READ_ONLY " (읽기 전용)"
