// Turkish (Türkiye). {0}, {1}, ... are std::format arguments.

#pragma code_page(65001)

LANGUAGE LANG_TURKISH, SUBLANG_TURKISH_TURKEY

STRINGTABLE
BEGIN
    IDS_CLI_USAGE "Kullanım: TISCSICli [seçenekler] [--target <name>] <disk>... [--target <name> <disk>...]...\n\n\
Disk görüntülerini ve RAM disklerini iSCSI başlatıcılarına sunar.\n\n\
Diskler (her biri geçerli hedefin bir sonraki LUN'u olur):\n\
  --image <path>       Okuma-yazma disk görüntüsü (.vhd, .vhdx, .avhdx, .vmdk; diğer uzantılar: ham)\n\
                       .iso görüntüsü salt okunur CD/DVD-ROM sürücüsüdür\n\
  --image-ro <path>    Salt okunur disk görüntüsü\n\
  --cdrom <path>       Herhangi bir dosyayı salt okunur CD/DVD-ROM diski olarak sun\n\
  --ram <size>         Yeni RAM diski, ör. 512M veya 2G\n\
  --disk <disk>        Okuma-yazma fiziksel disk (birimleri kilitlenir): disk\n\
                       numarası veya --list ile gösterilen, disk numarası\n\
                       değişse de aynı kalan kalıcı ad\n\
                       (serial:<seri numarası>, gpt:{<disk GUID>},\n\
                       mbr:<disk imzası>)\n\
  --disk-ro <disk>     Salt okunur fiziksel disk\n\
  --volume <volume>    Okuma-yazma birim: E:, bağlama noktası,\n\
                       \\\\?\\Volume{...}\\ veya --list ile gösterilen kalıcı ad\n\
                       (gpt:{<bölüm GUID>}, mbr:<disk imzası>:<uzaklık>)\n\
  --volume-ro <volume> Salt okunur birim\n\
  --dynamic-volume <id>\n\
                       Okuma-yazma dinamik birim (GUID, Volume1 gibi bir ad\n\
                       veya E:); Windows'un bağlamadığı birimler de desteklenir\n\
  --dynamic-volume-ro <id>\n\
                       Salt okunur dinamik birim\n\
  --ldm-disk <image>   Dinamik birimleri fiziksel diskler yerine bu üye disk\n\
                       görüntüsünde ara (her üye için tekrarlayın)\n\n\
Hedefler:\n\
  --target <name>      Yeni hedef başlat; sonraki diskler bu hedefe aittir.\n\
                       İlk --target öncesinde verilen diskler\n\
                       iqn.1991-05.com.microsoft:target1 hedefine aittir\n\
  --spti <device>      Hedefin SCSI komutlarını yerel bir aygıta aktar\n\
                       (\\\\.\\CdRom0, \\\\.\\Tape0, \\\\.\\Scsi2:, ...)\n\
                       veya serial:<seri numarası> kullan (bkz. --list)\n\
  --list               Fiziksel diskleri, birimleri, dinamik birimleri ve SCSI\n\
                       aygıtlarını listele (diskler, birimler ve --spti yönetici\n\
                       hakları gerektirir; --ldm-disk kaynaklı birimler hariç)\n\n\
VHD oluşturma (sonrasında sunucu yalnızca disk verilmişse başlar):\n\
  --create-vhd <path>  Yeni VHD dosyası oluştur\n\
  --size <size>        Yeni VHD boyutu, ör. 20G (en fazla 2040G)\n\
  --dynamic            Dinamik olarak genişleyen VHD (varsayılan: sabit boyut)\n\n\
Sunucu:\n\
  --listen <address>   Dinlenecek IPv4 adresi (varsayılan: tüm arabirimler)\n\
  --port <port>        TCP bağlantı noktası (varsayılan: 3260)\n\
  --log <file>         Günlüğü ayrıca bir dosyaya yaz\n\
  --verbosity <level>  error, warning, info (varsayılan), verbose veya debug\n\
  --wait <seconds>     Başlangıçta henüz hazır olmayan diskleri, birimleri,\n\
                       görüntüleri ve --listen adresini bu süre boyunca bekle\n\
  --skip-unavailable   Bir hedef açılamazsa diğerlerini sun\n\
                       (varsayılan: hiçbirini sunma)\n\
  --lang <tag>         Dil: en-US, ja-JP, zh-CN, zh-TW, ko-KR veya tr-TR\n\
                       (varsayılan: Windows dili)\n\
  --help               Bu yardımı göster\n\n"
    IDS_CLI_USAGE_MORE "Erişim denetimi (geçerli hedef için):\n\
  --allow-initiator <name>\n\
                       Yalnızca bu başlatıcı oturum açabilir (çoğaltılabilir);\n\
                       diğerleri keşif sırasında hedefi göremez\n\
  --chap-secret <secret>\n\
                       Bu parolayla CHAP zorunlu olsun (12 ile 255 karakter)\n\
  --chap-user <name>   Başlatıcının CHAP adı (varsayılan: herhangi bir ad)\n\
  --mutual-chap-secret <secret>\n\
                       Başlatıcının karşılıklı CHAP sınamasına yanıt parolası\n\
                       (--chap-secret değerinden farklı olmalıdır)\n\
  --mutual-chap-user <name>\n\
                       Hedefin CHAP adı (varsayılan: hedef adı)\n\
                       Komut satırındaki parolalar diğer programlar tarafından\n\
                       görülebilir; yapılandırma dosyası kullanın\n\n\
Yapılandırma dosyaları:\n\
  --config <file>      Sunucu seçeneklerini, hedefleri ve diskleri dosyadan oku;\n\
                       ayrıca verilen sunucu seçenekleri dosyadakileri geçersiz kılar\n\
  --save-config <file> Sunmak yerine hedefleri ve seçenekleri dosyaya yaz;\n\
                       aygıtlar kalıcı adlarıyla kaydedilir\n\n\
Windows hizmeti (yönetici hakları gerektirir):\n\
  --install-service    --config dosyasını Windows başlangıcından itibaren,\n\
                       oturum açılmadan sunan hizmeti yükle ve başlat. Güncellemek\n\
                       için tekrar çalıştırın. Günlük, dosyanın günlük ayarına\n\
                       veya yapılandırma yanındaki TISCSI-service.log dosyasına yazılır\n\
  --uninstall-service  Hizmeti durdur ve kaldır\n\
  --service-name <name>\n\
                       Hizmet adı (varsayılan: TISCSI)\n\n\
Örnek:\n\
  TISCSICli --target iqn.2026-10.example:disk1 --image D:\\disk.vhd --ram 1G\n\
  TISCSICli --create-vhd D:\\new.vhd --size 20G --dynamic --image D:\\new.vhd\n\
  TISCSICli --config D:\\tiscsi\\server.conf --wait 60\n\
  TISCSICli --install-service --config D:\\tiscsi\\server.conf\n"
    IDS_CLI_LISTENING "{0}:{1} dinleniyor"
    IDS_CLI_TARGET "Hedef: {0}"
    IDS_CLI_LUN "  LUN {0}: {1}, {2}{3}"
    IDS_CLI_READ_ONLY " (salt okunur)"
    IDS_CLI_RAM_DISK "RAM diski"
    IDS_CLI_PRESS_CTRL_C "Sunucuyu durdurmak için Ctrl+C tuşlarına basın."
