// Chinese (Simplified, PRC). Missing entries fall back to en-US.

#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
    IDS_CLI_USAGE "用法: TISCSICli [选项] [--target <名称>] <磁盘>... [--target <名称> <磁盘>...]...\n\n\
向 iSCSI 发起程序提供磁盘映像和内存盘。\n\n\
磁盘 (按指定顺序依次成为当前目标的 LUN):\n\
  --image <路径>       磁盘映像，可读写 (.vhd、.vmdk；其他扩展名按原始映像处理)\n\
  --image-ro <路径>    磁盘映像，只读\n\
  --ram <大小>         新建内存盘，例如 512M 或 2G\n\
  --disk <编号>        物理磁盘，可读写 (锁定其上的卷)\n\
  --disk-ro <编号>     物理磁盘，只读\n\
  --volume <卷>        卷 (E:、装入点或 \\\\?\\Volume{...}\\)，可读写\n\
  --volume-ro <卷>     卷，只读\n\
  --dynamic-volume <ID>\n\
                       动态卷 (GUID、Volume1 之类的名称或 E:)，可读写；\n\
                       也可使用 Windows 未装入的卷\n\
  --dynamic-volume-ro <ID>\n\
                       动态卷，只读\n\
  --ldm-disk <映像>    从成员磁盘的此映像 (而不是物理磁盘) 中查找动态卷\n\
                       (每个成员磁盘指定一次)\n\n\
目标:\n\
  --target <名称>      开始一个新目标，其后的磁盘都属于它。\n\
                       在任何 --target 之前指定的磁盘属于\n\
                       iqn.1991-05.com.microsoft:target1\n\
  --spti <设备>        将目标的 SCSI 命令直通到本地设备\n\
                       (\\\\.\\CdRom0、\\\\.\\Tape0、\\\\.\\Scsi2: 等)\n\
  --list               列出物理磁盘、卷、动态卷和 SCSI 设备\n\
                       (磁盘、卷和 --spti 需要管理员权限，\n\
                       来自 --ldm-disk 的动态卷除外)\n\n\
创建 VHD (仅当同时指定了磁盘时，之后才会启动服务器):\n\
  --create-vhd <路径>  创建新的 VHD 文件\n\
  --size <大小>        新 VHD 的大小，例如 20G (最大 2040G)\n\
  --dynamic            创建动态扩展的 VHD (默认: 固定大小)\n\n\
服务器:\n\
  --listen <地址>      侦听的 IPv4 地址 (默认: 所有接口)\n\
  --port <端口>        TCP 端口 (默认: 3260)\n\
  --log <文件>         同时将日志写入文件\n\
  --verbosity <级别>   error、warning、info (默认)、verbose 或 debug\n\
  --lang <标记>        界面语言: en-US、ja-JP、zh-CN、zh-TW 或 ko-KR\n\
                       (默认: Windows 显示语言)\n\
  --help               显示此帮助\n\n\
示例:\n\
  TISCSICli --target iqn.2026-10.example:disk1 --image D:\\disk.vhd --ram 1G\n\
  TISCSICli --create-vhd D:\\new.vhd --size 20G --dynamic --image D:\\new.vhd\n"
    IDS_CLI_LISTENING "正在侦听 {0}:{1}"
    IDS_CLI_TARGET "目标: {0}"
    IDS_CLI_LUN "  LUN {0}: {1}，{2}{3}"
    IDS_CLI_READ_ONLY " (只读)"
    IDS_CLI_RAM_DISK "内存盘"
    IDS_CLI_PRESS_CTRL_C "按 Ctrl+C 停止服务器。"
    IDS_CLI_STOPPING "正在停止服务器..."
    IDS_CLI_STOPPED "服务器已停止。"
    IDS_CLI_CREATING "正在创建 {0} ({1}，{2})..."
    IDS_CLI_CREATED "已创建 {0}。"
    IDS_CLI_VHD_FIXED "固定大小"
    IDS_CLI_VHD_DYNAMIC "动态扩展"
    IDS_CLI_PHYSICAL_DISK "物理磁盘 {0}"
    IDS_CLI_VOLUME "卷 {0}"
    IDS_CLI_SPTI "  SCSI 直通到 {0} ({1} 个 LUN)"
    IDS_CLI_HINT_ADMIN "使用物理磁盘、卷和 SCSI 直通需要以管理员身份运行。"
    IDS_CLI_LIST_DISKS "物理磁盘:"
    IDS_CLI_LIST_DISK "  {0}: {1}，{2}{3}"
    IDS_CLI_LIST_DYNAMIC " (动态磁盘)"
    IDS_CLI_LIST_VOLUMES "卷:"
    IDS_CLI_LIST_VOLUME "  {0}\n    装入点: {1}；文件系统: {2}；卷标: {3}；大小: {4}；所在磁盘: {5}"
    IDS_CLI_LIST_SCSI "SCSI 设备:"
    IDS_CLI_LIST_DYNAMIC_VOLUMES "动态卷:"
    IDS_CLI_LIST_DYNAMIC_VOLUME "  {0}  {1}\n    磁盘组: {2}；布局: {3}；状态: {4}；大小: {5}；所在磁盘: {6}\n    {7}"
    IDS_CLI_LIST_WINDOWS_VOLUME "Windows 卷: {0}"
    IDS_CLI_LIST_NOT_MOUNTED "Windows 未装入；直接从成员磁盘提供"
    IDS_CLI_DYNAMIC_VOLUME "动态卷 {0}"
    IDS_CLI_LAYOUT_SIMPLE "简单"
    IDS_CLI_LAYOUT_SPANNED "跨区"
    IDS_CLI_LAYOUT_STRIPED "带区"
    IDS_CLI_LAYOUT_MIRRORED "镜像"
    IDS_CLI_LAYOUT_RAID5 "RAID-5"
    IDS_CLI_HEALTH_HEALTHY "良好"
    IDS_CLI_HEALTH_FAILED_REDUNDANCY "失败的重复"
    IDS_CLI_HEALTH_FAILED "失败"

    IDS_CLI_ERR_UNKNOWN_OPTION "未知选项: {0}"
    IDS_CLI_ERR_MISSING_VALUE "选项 {0} 需要一个值。"
    IDS_CLI_ERR_INVALID_SIZE "大小无效: {0}"
    IDS_CLI_ERR_INVALID_PORT "端口无效: {0}"
    IDS_CLI_ERR_INVALID_ADDRESS "IPv4 地址无效: {0}"
    IDS_CLI_ERR_INVALID_LEVEL "日志级别无效: {0}"
    IDS_CLI_ERR_INVALID_TARGET_NAME "iSCSI 目标名称无效: {0}"
    IDS_CLI_ERR_DUPLICATE_TARGET "目标名称重复: {0}"
    IDS_CLI_ERR_NO_DISKS "未指定磁盘。请使用 --image、--image-ro 或 --ram。"
    IDS_CLI_ERR_TARGET_WITHOUT_DISKS "目标 {0} 没有磁盘。"
    IDS_CLI_ERR_OPEN_IMAGE "无法打开磁盘映像 {0}: {1}"
    IDS_CLI_ERR_RAM_ALLOC "无法分配 {0} 的内存盘。"
    IDS_CLI_ERR_LOG_FILE "无法打开日志文件 {0}: {1}"
    IDS_CLI_ERR_START "无法启动服务器: {0}"
    IDS_CLI_ERR_HINT_HELP "运行 TISCSICli --help 查看用法。"
    IDS_CLI_ERR_VHD_SIZE "VHD 大小无效: {0} (必须是 512 字节的倍数，最大 2040 GiB)"
    IDS_CLI_ERR_CREATE_NEEDS_SIZE "--create-vhd 需要 --size。"
    IDS_CLI_ERR_SIZE_WITHOUT_CREATE "--size 和 --dynamic 只能与 --create-vhd 一起使用。"
    IDS_CLI_ERR_CREATE "无法创建 {0}: {1}"
    IDS_CLI_ERR_INVALID_DISK "磁盘编号无效: {0} (请参阅 --list)"
    IDS_CLI_ERR_SPTI_MIXED "目标 {0}: --spti 不能与磁盘或另一个 --spti 同时使用。"
    IDS_CLI_ERR_OPEN_SPTI "无法打开 SCSI 设备 {0}: {1}"
    IDS_CLI_ERR_DYNAMIC_DISK "{0} 是动态磁盘。从发起程序写入很可能会损坏动态磁盘数据库，请以只读方式提供 (--disk-ro)。"
    IDS_CLI_ERR_VOLUME_LOCKED "无法以独占方式锁定卷 {0} ({1})。请关闭正在使用它的程序，或以只读方式提供。"
    IDS_CLI_ERR_ALREADY_SERVED "{0} 已在提供中。"
    IDS_CLI_ERR_WRITE_PROTECTED "{0} 处于写保护状态，请以只读方式提供。"
    IDS_CLI_ERR_OPEN_DEVICE "无法打开“{0}”: {1}"
    IDS_CLI_ERR_NO_SUCH_VOLUME "没有与“{0}”匹配的动态卷 (请参阅 --list)。"
    IDS_CLI_ERR_AMBIGUOUS_VOLUME "有多个名为“{0}”的动态卷，请使用其 GUID (请参阅 --list)。"
    IDS_CLI_ERR_VOLUME_FAILED "无法使用动态卷“{0}”: 存放其数据的磁盘缺失。"
    IDS_CLI_ERR_DEGRADED_WRITE "动态卷“{0}”缺少成员磁盘。写入会导致各成员不一致，请以只读方式提供 (--dynamic-volume-ro)。"
    IDS_CLI_ERR_LDM_UNUSED "--ldm-disk 只能与 --dynamic-volume、--dynamic-volume-ro 或 --list 一起使用。"
END
